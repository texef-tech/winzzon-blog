{
  "info": {
    "name": "Winzzon Blog API",
    "description": "Complete API collection for the Winzzon headless blog backend. Set the `baseUrl` and `password` collection variables. After running Admin > Login, the `authToken` variable is auto-populated for protected requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://staging-blog.winzzon.com" },
    { "key": "username", "value": "admin" },
    { "key": "password", "value": "Hob36044" },
    { "key": "authToken", "value": "" },
    { "key": "postId", "value": "" },
    { "key": "categoryId", "value": "" },
    { "key": "tagId", "value": "" },
    { "key": "mediaId", "value": "" },
    { "key": "postSlug", "value": "" }
  ],
  "item": [
    {
      "name": "Health & SEO",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
          }
        },
        {
          "name": "Sitemap",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/sitemap.xml", "host": ["{{baseUrl}}"], "path": ["sitemap.xml"] }
          }
        },
        {
          "name": "RSS Feed",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/rss.xml", "host": ["{{baseUrl}}"], "path": ["rss.xml"] }
          }
        },
        {
          "name": "Robots.txt",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/robots.txt", "host": ["{{baseUrl}}"], "path": ["robots.txt"] }
          }
        }
      ]
    },
    {
      "name": "Public API",
      "item": [
        {
          "name": "List Posts",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/posts?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "posts"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Get Post by Slug",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/posts/{{postSlug}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "posts", "{{postSlug}}"] }
          }
        },
        {
          "name": "List Categories",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/categories", "host": ["{{baseUrl}}"], "path": ["api", "v1", "categories"] }
          }
        },
        {
          "name": "Posts by Category",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/categories/technology/posts", "host": ["{{baseUrl}}"], "path": ["api", "v1", "categories", "technology", "posts"] }
          }
        },
        {
          "name": "List Tags",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/tags", "host": ["{{baseUrl}}"], "path": ["api", "v1", "tags"] }
          }
        },
        {
          "name": "Posts by Tag",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/tags/golang/posts", "host": ["{{baseUrl}}"], "path": ["api", "v1", "tags", "golang", "posts"] }
          }
        },
        {
          "name": "Search Posts",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/search?q=hello",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "search"],
              "query": [{ "key": "q", "value": "hello" }]
            }
          }
        }
      ]
    },
    {
      "name": "Admin - Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.token) {",
                  "  pm.collectionVariables.set('authToken', res.token);",
                  "  console.log('authToken set');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/admin/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "auth", "login"] }
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/admin/auth/refresh", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "auth", "refresh"] }
          }
        }
      ]
    },
    {
      "name": "Admin - Posts",
      "item": [
        {
          "name": "List All Posts (admin)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/posts?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "posts"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Get Post by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/admin/posts/{{postId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "posts", "{{postId}}"] }
          }
        },
        {
          "name": "Create Post",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.id) {",
                  "  pm.collectionVariables.set('postId', res.id);",
                  "  pm.collectionVariables.set('postSlug', res.slug);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Hello World\",\n  \"body\": \"<p>This is my first post.</p>\",\n  \"excerpt\": \"My first post\",\n  \"category_ids\": [],\n  \"tag_ids\": []\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/admin/posts", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "posts"] }
          }
        },
        {
          "name": "Update Post",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Hello World Updated\",\n  \"body\": \"<p>Updated body.</p>\",\n  \"excerpt\": \"Updated excerpt\",\n  \"category_ids\": [],\n  \"tag_ids\": []\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/admin/posts/{{postId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "posts", "{{postId}}"] }
          }
        },
        {
          "name": "Publish Post",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/admin/posts/{{postId}}/publish", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "posts", "{{postId}}", "publish"] }
          }
        },
        {
          "name": "Unpublish Post",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/admin/posts/{{postId}}/unpublish", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "posts", "{{postId}}", "unpublish"] }
          }
        },
        {
          "name": "Delete Post",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/admin/posts/{{postId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "posts", "{{postId}}"] }
          }
        }
      ]
    },
    {
      "name": "Admin - SEO",
      "item": [
        {
          "name": "Get SEO Meta",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/admin/posts/{{postId}}/seo", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "posts", "{{postId}}", "seo"] }
          }
        },
        {
          "name": "Upsert SEO Meta",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"meta_title\": \"Hello World | Winzzon\",\n  \"meta_description\": \"A great first post about anything.\",\n  \"og_title\": \"Hello World\",\n  \"og_description\": \"A great first post\",\n  \"og_image\": \"https://example.com/og.png\",\n  \"canonical_url\": \"https://winzzon.com/blog/hello-world\",\n  \"focus_keyword\": \"hello world\",\n  \"schema_type\": \"BlogPosting\",\n  \"no_index\": false\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/admin/posts/{{postId}}/seo", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "posts", "{{postId}}", "seo"] }
          }
        }
      ]
    },
    {
      "name": "Admin - Media",
      "item": [
        {
          "name": "Upload Media",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.id) pm.collectionVariables.set('mediaId', res.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": [] }
              ]
            },
            "url": { "raw": "{{baseUrl}}/api/v1/admin/media/upload", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "media", "upload"] }
          }
        },
        {
          "name": "List Media",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/admin/media", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "media"] }
          }
        },
        {
          "name": "Delete Media",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/admin/media/{{mediaId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "media", "{{mediaId}}"] }
          }
        }
      ]
    },
    {
      "name": "Admin - Categories",
      "item": [
        {
          "name": "Create Category",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.id) pm.collectionVariables.set('categoryId', res.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Technology\",\n  \"description\": \"Tech-related posts\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/admin/categories", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "categories"] }
          }
        },
        {
          "name": "Update Category",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Tech\",\n  \"description\": \"Updated description\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/admin/categories/{{categoryId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "categories", "{{categoryId}}"] }
          }
        },
        {
          "name": "Delete Category",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/admin/categories/{{categoryId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "categories", "{{categoryId}}"] }
          }
        }
      ]
    },
    {
      "name": "Admin - Tags",
      "item": [
        {
          "name": "Create Tag",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.id) pm.collectionVariables.set('tagId', res.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Golang\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/admin/tags", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "tags"] }
          }
        },
        {
          "name": "Update Tag",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Go\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/admin/tags/{{tagId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "tags", "{{tagId}}"] }
          }
        },
        {
          "name": "Delete Tag",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/admin/tags/{{tagId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "tags", "{{tagId}}"] }
          }
        }
      ]
    }
  ]
}
