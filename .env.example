# Server
PORT=8080
ENV=development # development | production

# Database
DATABASE_URL=postgres://user:password@localhost:5432/winzzon_blog?sslmode=disable

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-very-long-random-secret-key
JWT_EXPIRY_HOURS=24

# Admin credentials (used by seed script on first boot)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-on-first-boot

# Media Storage (Cloudflare R2 or AWS S3 compatible)
S3_ENDPOINT=https://your-account.r2.cloudflarestorage.com
S3_BUCKET=winzzon-media
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
S3_CDN_URL=https://cdn.winzzon.com

# Search (Meilisearch)
MEILI_URL=http://localhost:7700
MEILI_API_KEY=your-meili-key

# CORS (Comma-separated list of allowed origins)
ALLOWED_ORIGINS=http://localhost:3000,https://winzzon.com,https://admin-winzzon-blog.vercel.app

# Site info (used for sitemap, RSS, schema.org)
SITE_URL=https://winzzon.com
SITE_NAME=Winzzon
